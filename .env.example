# Base URL for the cf88.me API (channels, videos, fights)
NUXT_PUBLIC_API_BASE=https://cf88.me/api

# Public URL this site is deployed at — used to build absolute Open Graph URLs
NUXT_PUBLIC_SITE_URL=https://v168.shoop

# Telegram channel/group link shown in the header
NUXT_PUBLIC_TELEGRAM_URL=https://t.me/V_VDOVIP
NUXT_PUBLIC_TELEGRAM_USERNAME=V_VDOVIP

# --- Server-only (never sent to the browser) ---

# Base URL for the admin API (used by server/api/fightactive.get.ts)
NUXT_ADMIN_API_BASE=https://admin.cf88.me/api

# Live-stream resolver endpoint (used by server/api/stream.post.ts)
NUXT_STREAM_RESOLVER_URL=https://live-snip-production.up.railway.app/channel
# NUXT_STREAM_RESOLVER_URL=https://live-snip-production.up.railway.app/health
